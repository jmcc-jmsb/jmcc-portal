# Copy to .env and fill in. .env is gitignored; this file is not.
# HANDOFF §12. Anything marked "server only" must never appear in a client bundle —
# only src/lib/server/ and src/pages/api/ may read them.

# Supabase → Settings → API keys. These are the current names: the publishable
# key is safe in a browser bundle, the secret key bypasses RLS entirely. Older
# projects call the same two "anon" and "service_role".
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=              # server only

DOCUSEAL_BASE_URL=https://sign.jmccjmsb.ca
DOCUSEAL_API_TOKEN=               # server only
DOCUSEAL_WEBHOOK_SECRET=          # server only

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                # server only
VAPID_SUBJECT=                    # mailto: or https: contact, sent with every push

PUBLIC_APP_URL=http://localhost:4321

# Dev-only affordances: the role, vault-state and cabinet-fill switchers from the
# prototype. Unset or "false" in production — a delegate must never see them.
PUBLIC_ENABLE_DEV_CONTROLS=true
