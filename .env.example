# Copy to .env and fill in. .env is gitignored; this file is not.
# HANDOFF §12. Anything marked "server only" must never appear in a client bundle —
# only src/lib/server/ and src/pages/api/ may read them.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only

DOCUSEAL_BASE_URL=https://sign.jmccjmsb.ca
DOCUSEAL_API_TOKEN=               # server only
DOCUSEAL_WEBHOOK_SECRET=          # server only

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                # server only

PUBLIC_APP_URL=http://localhost:4321

# Dev-only affordances: the role, vault-state and cabinet-fill switchers from the
# prototype. Unset or "false" in production — a delegate must never see them.
PUBLIC_ENABLE_DEV_CONTROLS=true
